# 数据库与缓存（必填）
DATABASE_URL=postgres://user:password@127.0.0.1:5432/baofei
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=baofei:

# 对象存储（Garage S3）
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=baofei
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── VIN 查询渠道 ─────────────────────────────────────────
# 按优先级逗号分隔；渠道 id 需在 src/lib/vin 中注册
VIN_PROVIDER_ORDER=jisuepc
VIN_TIMEOUT_MS=6000
VIN_CACHE_TTL_SECONDS=2592000
VIN_MISS_TTL_SECONDS=600
# 仅在排查问题时打开：把渠道原始返回写入 vin_lookups.raw
VIN_DEBUG_RAW=0

# 极速车服 https://www.jisuepc.com/api/vin/
JISUEPC_APPKEY=
JISUEPC_BASE_URL=https://api.jisuepc.com
# 1 = 让渠道严格校验 VIN；默认 0，本地已做 17 位校验
JISUEPC_STRICT=0