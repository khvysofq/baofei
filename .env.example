# 站点对外地址（用于 canonical / sitemap / Open Graph）
NEXT_PUBLIC_SITE_URL=https://baofei.publicrandom.com

# ── 存储驱动 ─────────────────────────────────────────────
# pg      = 独立 Postgres（有 DATABASE_URL 时的默认值）
# pglite  = 嵌入式 Postgres（WASM），数据落在 PGLITE_DATA_DIR，无需数据库服务
# DB_DRIVER=pglite
# PGLITE_DATA_DIR=.data/pglite

# 需要 Postgres 时才填；留空自动走 PGlite
DATABASE_URL=postgres://user:password@127.0.0.1:5432/baofei

# 缓存：redis | db | memory。未设置时有 REDIS_URL 用 Redis，否则用 db。
# db = 写 cache_entries 表，跨重启保留（VIN 缓存 30 天必须用这个）
# CACHE_DRIVER=db
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=baofei:

# 对象存储：未配置 S3_ENDPOINT 时本地直接生成样例 SVG，不依赖对象存储
# STORAGE_DRIVER=local
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=baofei
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── VIN 查询渠道 ─────────────────────────────────────────
# 按优先级逗号分隔；渠道 id 需在 src/lib/vin 中注册
VIN_PROVIDER_ORDER=jisuepc
VIN_TIMEOUT_MS=6000
VIN_CACHE_TTL_SECONDS=2592000
VIN_MISS_TTL_SECONDS=600
# strict = 按 GB 16735 校验第 9 位校验码；off = 只校验结构（旧车/改装车兼容）
VIN_CHECK_DIGIT=strict
# 仅在排查问题时打开：把渠道原始返回写入 vin_lookups.raw
VIN_DEBUG_RAW=0

# ── 防刷与渠道额度保护 ───────────────────────────────────
# 同一 IP 的 VIN 查询频率上限（普通用户 1–2 次/分钟足够）
VIN_RATE_LIMIT_PER_MINUTE=8
VIN_RATE_LIMIT_PER_HOUR=40
VIN_RATE_LIMIT_PER_DAY=120
# 每天真正调用供应商渠道的总次数上限；缓存命中不计数
VIN_DAILY_CALL_LIMIT=5000
# 1 = 紧急停用渠道查询（缓存仍可用），0 = 正常
VIN_KILL_SWITCH=0

# 极速车服 https://www.jisuepc.com/api/vin/
JISUEPC_APPKEY=
JISUEPC_BASE_URL=https://api.jisuepc.com
# 1 = 让渠道严格校验 VIN；默认 0，本地已做 17 位校验
JISUEPC_STRICT=0

# ── 管理后台（/guanli） ───────────────────────────────────
# 登录密码；未设置时 /guanli 显示配置说明，/api/guanli/* 返回 503
ADMIN_PASSWORD=
# 可选：会话签名密钥；未设置时使用 ADMIN_PASSWORD
ADMIN_SESSION_SECRET=